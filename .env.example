APP_NAME=DevTrend
ENV=dev

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=

# LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
# v4 provider selection: "ollama" | "nim" | "openai" | "mock"
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# NIM (NVIDIA) — leave blank unless using NIM
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_LLM_MODEL=meta/llama-3.1-70b-instruct
NIM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NIM_RATE_LIMIT_ENABLED=true
NIM_RATE_LIMIT_RPM=40

# OpenAI — leave blank unless using OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4.1-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# v4 pipeline settings
EXTRACTION_BATCH_SIZE=20
EMBEDDING_BATCH_SIZE=64
IDENTITY_RESOLUTION_THRESHOLD=0.82
CLUSTERING_MIN_CLUSTER_SIZE=3
SPECIFICITY_GATE=2
MAX_ALERTS_PER_DAY=3
PIPELINE_CRON_HOUR=3
PIPELINE_CRON_MINUTE=30

# Database
DATABASE_URL=sqlite+aiosqlite:///./devtrend.db

# Data Sources
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=DevTrend/1.0 (by /u/yourhandle)
ENABLE_MOCK_APPSTORE=true
REDDIT_SUBREDDITS=startups,SideProject,Entrepreneur,reactnative,androiddev,iOSProgramming
GITHUB_STAR_THRESHOLD=50
GITHUB_SEARCH_LOOKBACK_DAYS=14
INGESTION_HTTP_TIMEOUT_S=20.0
INGESTION_JOB_TIMEOUT_S=180.0

# Play Store ingestion (runs at PLAYSTORE_CRON_HOUR UTC; pipeline at 03:30 picks up new items)
PLAYSTORE_CRON_HOUR=2
PLAYSTORE_TOP_N_PER_CATEGORY=50
PLAYSTORE_REVIEWS_PER_APP=200

# iOS App Store RSS ingestion
ENABLE_IOS_RSS=false

# Weekly re-cluster (merges drifted candidates, splits overbroad ones)
WEEKLY_RECLUSTER_CRON_HOUR=4
WEEKLY_RECLUSTER_CRON_DAY=sun

# Scheduling
DAILY_DIGEST_TIME=08:00
SPIKE_ALERT_THRESHOLD=15

# Bulk backfill (runs once on startup if SourceItem table is empty)
BACKFILL_ON_EMPTY=true
BACKFILL_HISTORY_DAYS=30
BACKFILL_MAX_ITEMS_PER_SOURCE=1000

# Pruning (weekly Sunday job)
SOURCE_RETENTION_DAYS=90
SIGNAL_RETENTION_DAYS=30
PRUNING_CRON_HOUR=3

# Logging
LOG_LEVEL=INFO
