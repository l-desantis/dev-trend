{"nodes": [{"id": "plans_2026_05_15_reddit_rss_migration_reddit_rss_migration", "label": "Reddit RSS Migration Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-05-15-reddit-rss-migration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_2026_05_15_reddit_rss_migration_reddit_connector", "label": "RedditConnector (RSS rewrite)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-05-15-reddit-rss-migration.md", "source_location": "app/ingestion/reddit_connector.py", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_2026_05_15_reddit_rss_migration_atom_rss_feed", "label": "Reddit Atom/RSS Feed Endpoint", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-05-15-reddit-rss-migration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reddit's JSON API blocks datacenter IPs via TLS fingerprinting (JA3/JA4). The /new.rss endpoint sits on a different code path and returns 200. Chosen because it is frozen-stable for 15+ years and has no auth requirement."}, {"id": "plans_2026_05_15_reddit_rss_migration_entry_to_child", "label": "_entry_to_child Atom adapter", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-05-15-reddit-rss-migration.md", "source_location": "app/ingestion/reddit_connector.py", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plans_2026_05_15_reddit_rss_migration_reddit_rate_limited", "label": "RedditRateLimited (removed)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-05-15-reddit-rss-migration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removed because the RSS endpoint does not exhibit 403/429 failure modes. Per-sub graceful skip subsumes the abort behavior."},