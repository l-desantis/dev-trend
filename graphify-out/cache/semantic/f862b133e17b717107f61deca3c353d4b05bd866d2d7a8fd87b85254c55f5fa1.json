{"nodes": [{"id": "specs_2026_04_28_opportunity_discovery_pivot_design_v4_design", "label": "DevTrend v4 Opportunity Discovery Pivot Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-04-28-opportunity-discovery-pivot-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_2026_04_28_opportunity_discovery_pivot_design_pain_point_pipeline", "label": "Pain-Point-Driven Candidate Discovery Pipeline", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-04-28-opportunity-discovery-pivot-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces v3 niche-scoring pipeline. Unit of analysis moves from Niche (curated, fixed) to OpportunityCandidate (emergent, persistent, evidence-backed). Produces specific mid-precision app hypotheses rather than generic trending-topic hints."}, {"id": "specs_2026_04_28_opportunity_discovery_pivot_design_validation_curve_original", "label": "Validation Curve (original spec \u00a75.2)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-04-28-opportunity-discovery-pivot-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-monotonic: repo_count=0 \u2192 30 (green-field-risky), 1-5 repos no major star \u2192 90 (sweet spot), 6-20 repos \u2192 70, >20 or major incumbent \u2192 30 (saturated)."}, {"id": "specs_2026_04_28_opportunity_discovery_pivot_design_specificity_gate", "label": "Specificity Gate (\u00a75.4)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-04-28-opportunity-discovery-pivot-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_2026_04_28_opportunity_discovery_pivot_design_extraction_cache", "label": "Extraction Cache via PainPoint Rows", "file_